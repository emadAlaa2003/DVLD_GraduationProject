<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/Widget.DVLDMobile.DashboardCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layoutDirection="rtl">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/login_icon_background"
                android:importantForAccessibility="no"
                android:padding="9dp"
                app:srcCompat="@drawable/ic_dashboard_license"
                app:tint="@color/login_teal" />
            <TextView
                android:id="@+id/license_card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:gravity="start"
                android:textAppearance="@style/TextAppearance.DVLDMobile.DashboardAction"
                android:textDirection="firstStrong" />
        </LinearLayout>
        <TextView
            android:id="@+id/license_card_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="start"
            android:lineSpacingExtra="7dp"
            android:textColor="@color/login_text_secondary"
            android:textDirection="rtl"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
