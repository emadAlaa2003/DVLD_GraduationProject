<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/dashboard_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_background"
    android:layoutDirection="rtl"
    android:orientation="vertical"
    tools:context=".ui.DashboardActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:background="@drawable/login_brand_strip"
        android:importantForAccessibility="no" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="24dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="@string/dashboard_greeting"
                        android:textColor="@color/login_text_secondary"
                        android:textSize="16sp" />
                    <TextView
                        android:id="@+id/dashboard_citizen_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:gravity="start"
                        android:textColor="@color/login_navy"
                        android:textDirection="firstStrong"
                        android:textSize="24sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ImageView
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="@drawable/login_icon_background"
                    android:backgroundTint="@color/login_navy"
                    android:importantForAccessibility="no"
                    android:padding="12dp"
                    app:srcCompat="@drawable/ic_login_person"
                    app:tint="@color/white" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <ProgressBar
                    android:id="@+id/dashboard_progress"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginEnd="8dp"
                    android:indeterminateTint="@color/login_teal"
                    android:visibility="gone" />
                <TextView
                    android:id="@+id/dashboard_status_message"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:gravity="start"
                    android:textColor="@color/login_text_secondary"
                    android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dashboard_refresh"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/dashboard_refresh"
                    android:textAllCaps="false"
                    android:textColor="@color/login_teal"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/login_outline" />
            </LinearLayout>

            <!-- Independent messages keep empty data separate from request failures. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/license_summary_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/login_navy"
                app:cardCornerRadius="24dp"
                app:cardElevation="3dp"
                app:strokeWidth="0dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:accessibilityHeading="true"
                            android:gravity="start"
                            android:text="@string/dashboard_license_summary"
                            android:textColor="@color/dashboard_on_navy_secondary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/login_icon_background"
                            android:backgroundTint="@color/dashboard_navy_soft"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_dashboard_license"
                            app:tint="@color/dashboard_on_navy_secondary" />
                    </LinearLayout>
                    <TextView
                        android:id="@+id/license_summary_message"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="start"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/dashboard_license_placeholder"
                        android:textColor="@color/white"
                        android:textSize="21sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/license_type_summaries"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/login_icon_background"
                            android:backgroundTint="@color/dashboard_navy_soft"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="start"
                                android:text="@string/dashboard_local_licenses"
                                android:textColor="@color/dashboard_on_navy_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/local_license_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="start"
                                android:text="@string/dashboard_unknown_value"
                                android:textColor="@color/white"
                                android:textSize="18sp" />
                        </LinearLayout>
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_weight="1"
                            android:background="@drawable/login_icon_background"
                            android:backgroundTint="@color/dashboard_navy_soft"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="start"
                                android:text="@string/dashboard_international_licenses"
                                android:textColor="@color/dashboard_on_navy_secondary"
                                android:textSize="12sp" />
                            <TextView
                                android:id="@+id/international_license_summary"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:gravity="start"
                                android:text="@string/dashboard_unknown_value"
                                android:textColor="@color/white"
                                android:textSize="18sp" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:baselineAligned="false"
                android:gravity="top"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.DVLDMobile.DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="112dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/login_icon_background"
                            android:backgroundTint="@color/login_teal_soft"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_dashboard_applications"
                            app:tint="@color/login_teal" />
                        <TextView
                            android:id="@+id/active_applications_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/dashboard_unknown_value"
                            android:textColor="@color/login_navy"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_active_applications"
                            android:textColor="@color/login_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.DVLDMobile.DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="112dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/login_icon_background"
                            android:backgroundTint="@color/dashboard_gold_soft"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_dashboard_calendar"
                            app:tint="@color/login_gold" />
                        <TextView
                            android:id="@+id/upcoming_appointment_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/dashboard_unknown_value"
                            android:textColor="@color/login_navy"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_upcoming_appointment"
                            android:textColor="@color/login_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.DVLDMobile.DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="112dp"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="10dp">
                        <ImageView
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="@drawable/login_icon_background"
                            android:backgroundTint="@color/login_teal_soft"
                            android:importantForAccessibility="no"
                            android:padding="7dp"
                            app:srcCompat="@drawable/ic_dashboard_license"
                            app:tint="@color/login_navy" />
                        <TextView
                            android:id="@+id/registered_licenses_value"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center"
                            android:text="@string/dashboard_unknown_value"
                            android:textColor="@color/login_navy"
                            android:textSize="26sp"
                            android:textStyle="bold" />
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="@string/dashboard_registered_licenses"
                            android:textColor="@color/login_text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:gravity="start"
                android:text="@string/dashboard_latest_application"
                android:textAppearance="@style/TextAppearance.DVLDMobile.DashboardSection" />
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/latest_application_card"
                style="@style/Widget.DVLDMobile.DashboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">
                <!-- Render the real latest application here; nullable fields are omitted. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="88dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="20dp">
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/login_icon_background"
                        android:importantForAccessibility="no"
                        android:padding="9dp"
                        app:srcCompat="@drawable/ic_dashboard_applications" />
                    <TextView
                        android:id="@+id/latest_application_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:lineSpacingExtra="4dp"
                        android:text="@string/dashboard_application_placeholder"
                        android:textColor="@color/login_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:accessibilityHeading="true"
                android:gravity="start"
                android:text="@string/dashboard_quick_actions"
                android:textAppearance="@style/TextAppearance.DVLDMobile.DashboardSection" />

            <!-- Quick actions are visual only; there are no click listeners or destinations. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dashboard_action_licenses"
                    style="@style/Widget.DVLDMobile.DashboardCard"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/dashboard_my_licenses"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="84dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/login_icon_background"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_dashboard_license" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/dashboard_my_licenses"
                            android:textAppearance="@style/TextAppearance.DVLDMobile.DashboardAction" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dashboard_action_applications"
                    style="@style/Widget.DVLDMobile.DashboardCard"
                    android:clickable="true"
                    android:focusable="true"
                    android:contentDescription="@string/dashboard_my_applications"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="84dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/login_icon_background"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_dashboard_applications" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/dashboard_my_applications"
                            android:textAppearance="@style/TextAppearance.DVLDMobile.DashboardAction" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dashboard_action_appointments"
                    style="@style/Widget.DVLDMobile.DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="84dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/login_icon_background"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_dashboard_calendar" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/dashboard_my_appointments"
                            android:textAppearance="@style/TextAppearance.DVLDMobile.DashboardAction" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dashboard_action_practice"
                    style="@style/Widget.DVLDMobile.DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="84dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/login_icon_background"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_dashboard_practice" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/dashboard_practice_exam"
                            android:textAppearance="@style/TextAppearance.DVLDMobile.DashboardAction" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/dashboard_action_assistant"
                    style="@style/Widget.DVLDMobile.DashboardCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    
                    android:layout_marginTop="12dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="84dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">
                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/login_icon_background"
                            android:importantForAccessibility="no"
                            android:padding="8dp"
                            app:srcCompat="@drawable/ic_dashboard_assistant" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:gravity="start"
                            android:text="@string/dashboard_traffic_assistant"
                            android:textAppearance="@style/TextAppearance.DVLDMobile.DashboardAction" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/login_outline"
        android:importantForAccessibility="no" />
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/dashboard_bottom_navigation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:background="@color/white"
        android:elevation="0dp"
        app:itemHorizontalTranslationEnabled="false"
        app:itemIconSize="22dp"
        app:itemIconTint="@color/dashboard_navigation_tint"
        app:itemTextAppearanceActive="@style/TextAppearance.DVLDMobile.DashboardNavigation"
        app:itemTextAppearanceInactive="@style/TextAppearance.DVLDMobile.DashboardNavigation"
        app:itemTextColor="@color/dashboard_navigation_tint"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/dashboard_bottom_navigation" />
</LinearLayout>
