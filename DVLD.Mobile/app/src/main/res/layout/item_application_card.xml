<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Widget.DVLDMobile.DashboardCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:layoutDirection="rtl">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">
        <TextView
            android:id="@+id/application_card_id"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:gravity="start"
            android:textAppearance="@style/TextAppearance.DVLDMobile.DashboardSection"
            android:textDirection="rtl" />
        <TextView
            android:id="@+id/application_card_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="start"
            android:lineSpacingExtra="4dp"
            android:textAppearance="@style/TextAppearance.DVLDMobile.DashboardAction"
            android:textDirection="rtl" />
        <TextView
            android:id="@+id/application_card_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginTop="12dp"
            android:background="@drawable/login_icon_background"
            android:gravity="center"
            android:paddingStart="14dp"
            android:paddingTop="6dp"
            android:paddingEnd="14dp"
            android:paddingBottom="6dp"
            android:textColor="@color/login_navy"
            android:textSize="13sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/application_card_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="start"
            android:lineSpacingExtra="7dp"
            android:textColor="@color/login_text_secondary"
            android:textDirection="rtl"
            android:textSize="14sp" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
